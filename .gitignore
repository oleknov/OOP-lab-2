# 1. Ignore everything
*

# 2. Un-ignore directories so git can traverse them.
#    This is necessary so git can find the files to un-ignore below.
!*/

# 3. Un-ignore the allowed file extensions
!*.cs
!*.xaml
!*.h
!*.jpg
!*.jpeg
!*.png
!*.in
!*.out
!*.ans
!*.md
!*.txt
!*.csproj
!*.sln

# MAUI project files (icons, fonts, platform manifests, launch settings)
!*.svg
!*.ttf
!*.json
!*.manifest
!*.appxmanifest
!*.plist
!*.xcprivacy
!*.xml

# Lab data: XML and XSL files
!*.xsl
!*.xslt

# 4. Ignore build output and Visual Studio local data
/bin
/obj
/.vs

# 5. Un-ignore this file itself so it can be committed
!/.gitignore